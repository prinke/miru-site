# Same values the bot uses.
MONGODB_URI=
MONGODB_DB=miru

# Discord application (Developer Portal > OAuth2). Add the redirect
# <site URL>/api/auth/callback/discord, e.g. http://localhost:4321/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Signs sessions. Generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Public URL of the site: http://localhost:4321 locally, the production URL on Vercel.
BETTER_AUTH_URL=http://localhost:4321

# Stripe (Dashboard → Developers → API keys). Use the test-mode key locally.
# Checkout is hosted by Stripe, so no publishable key is needed.
STRIPE_SECRET_KEY=sk_test_...
# Signing secret of the webhook endpoint <site URL>/api/stripe/webhook.
# Locally: `stripe listen --forward-to localhost:4321/api/stripe/webhook` prints one.
STRIPE_WEBHOOK_SECRET=whsec_...
