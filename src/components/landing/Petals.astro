---
// Drifting sakura petals. Purely decorative; hidden for reduced motion.
const petals = Array.from({ length: 14 }, (_, i) => {
	// Deterministic pseudo-random so builds are stable.
	const r = (n: number) => ((Math.sin(i * 9301 + n * 49297) + 1) / 2);
	return {
		left: Math.round(r(1) * 100),
		size: 10 + Math.round(r(2) * 12),
		delay: -(r(3) * 18).toFixed(1),
		duration: (14 + r(4) * 12).toFixed(1),
		sway: (3 + r(5) * 4).toFixed(1),
		opacity: (0.35 + r(6) * 0.45).toFixed(2),
	};
});
---

<div class="petals" aria-hidden="true">
	{
		petals.map((p) => (
			<span
				class="petal"
				style={`--left:${p.left}%;--size:${p.size}px;--delay:${p.delay}s;--dur:${p.duration}s;--sway:${p.sway}s;--o:${p.opacity}`}
			>
				<svg viewBox="0 0 20 20">
					<path d="M10 1c4 3 7 7 6 11s-4 7-6 7-5-3-6-7 2-8 6-11Z" />
					<path d="M10 1l0 5" class="notch" />
				</svg>
			</span>
		))
	}
</div>

<style>
	.petals {
		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
		z-index: 0;
	}
	.petal {
		position: absolute;
		top: -40px;
		left: var(--left);
		width: var(--size);
		height: var(--size);
		opacity: var(--o);
		animation: fall var(--dur) linear var(--delay) infinite;
	}
	.petal svg {
		width: 100%;
		height: 100%;
		animation: sway var(--sway) ease-in-out var(--delay) infinite alternate;
	}
	.petal path {
		fill: var(--petal);
	}
	.petal .notch {
		fill: none;
		stroke: var(--bg);
		stroke-width: 1.4;
		stroke-linecap: round;
	}
	@keyframes fall {
		to {
			transform: translateY(110vh) rotate(260deg);
		}
	}
	@keyframes sway {
		from {
			transform: translateX(-24px) rotate(-20deg);
		}
		to {
			transform: translateX(24px) rotate(25deg);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.petals {
			display: none;
		}
	}
</style>
