---
// A static mock of Miru's /anime reply, styled like a Discord message.
---

<figure class="dc" aria-label="Example: Miru's reply to /anime">
	<div class="dc-used">
		<span class="dc-curve"></span>
		<span class="dc-user">yui</span> used <span class="dc-cmd">/anime</span>
	</div>
	<div class="dc-msg">
		<img class="dc-avatar" src="/android-chrome-192x192.png" alt="" width="40" height="40" />
		<div class="dc-body">
			<div class="dc-head">
				<span class="dc-name">Miru</span>
				<span class="dc-app">APP</span>
				<span class="dc-time">Today at 21:04</span>
			</div>

			<div class="dc-embed">
				<div class="dc-embed-main">
					<div class="dc-embed-text">
						<a class="dc-title">Frieren: Beyond Journey's End</a>
						<div class="dc-romaji">Sousou no Frieren</div>
						<p class="dc-desc">
							An elf mage outlives the hero's party she travelled with, and sets out to
							understand the people she lost.
						</p>
					</div>
					<div class="dc-thumb" aria-hidden="true"><span>見る</span></div>
				</div>
				<dl class="dc-fields">
					<div><dt>Studio</dt><dd>Madhouse</dd></div>
					<div><dt>Format</dt><dd>TV</dd></div>
					<div><dt>Episodes</dt><dd>28 · 24 min</dd></div>
					<div><dt>Status</dt><dd>Finished</dd></div>
					<div><dt>Season</dt><dd>Fall 2023</dd></div>
					<div><dt>Genres</dt><dd>Adventure, Drama</dd></div>
				</dl>
				<div class="dc-footer">AniList · 1 of 25</div>
			</div>

			<div class="dc-select">
				<span>Frieren: Beyond Journey's End</span>
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5" /></svg>
			</div>
			<div class="dc-buttons">
				<span class="dc-btn">Remove from Watching</span>
				<span class="dc-btn primary">+1 ep · 21/28</span>
				<span class="dc-btn">★ 9</span>
			</div>
		</div>
	</div>
</figure>

<style>
	.dc {
		margin: 0;
		background: #313338;
		color: #dbdee1;
		border-radius: 18px;
		padding: 16px 18px 18px 12px;
		font-family: 'Figtree', system-ui, sans-serif;
		font-size: 14px;
		line-height: 1.375;
		box-shadow:
			0 1px 0 rgb(255 255 255 / 0.06) inset,
			0 30px 60px -20px rgb(120 30 70 / 0.45),
			0 12px 24px -12px rgb(60 10 40 / 0.35);
		text-align: left;
	}
	.dc-used {
		display: flex;
		align-items: center;
		gap: 4px;
		font-size: 12.5px;
		color: #949ba4;
		padding-left: 22px;
		margin-bottom: 4px;
	}
	.dc-curve {
		width: 26px;
		height: 10px;
		border-left: 2px solid #4e5058;
		border-top: 2px solid #4e5058;
		border-top-left-radius: 6px;
		margin-top: 8px;
		margin-right: 4px;
	}
	.dc-user {
		color: #f9a8d4;
		font-weight: 600;
	}
	.dc-cmd {
		color: #00a8fc;
	}
	.dc-msg {
		display: flex;
		gap: 14px;
	}
	.dc-avatar {
		width: 40px;
		height: 40px;
		border-radius: 50%;
		flex: none;
	}
	.dc-body {
		min-width: 0;
		flex: 1;
	}
	.dc-head {
		display: flex;
		align-items: center;
		gap: 6px;
	}
	.dc-name {
		color: #f2f3f5;
		font-weight: 600;
	}
	.dc-app {
		background: #5865f2;
		color: #fff;
		font-size: 10px;
		font-weight: 700;
		padding: 1px 5px;
		border-radius: 4px;
	}
	.dc-time {
		color: #949ba4;
		font-size: 12px;
	}
	.dc-embed {
		margin-top: 6px;
		background: #2b2d31;
		border-left: 4px solid #43b581;
		border-radius: 4px;
		padding: 10px 14px 12px 12px;
	}
	.dc-embed-main {
		display: flex;
		gap: 14px;
	}
	.dc-embed-text {
		flex: 1;
		min-width: 0;
	}
	.dc-title {
		color: #00a8fc;
		font-weight: 700;
		font-size: 15px;
	}
	.dc-romaji {
		font-size: 12.5px;
		font-style: italic;
		color: #b5bac1;
	}
	.dc-desc {
		margin: 8px 0 0;
		font-size: 13.5px;
	}
	.dc-thumb {
		flex: none;
		width: 72px;
		height: 100px;
		border-radius: 6px;
		background:
			radial-gradient(circle at 30% 25%, #fff6 0 8%, transparent 9%),
			linear-gradient(160deg, #b8e1d6, #8fb6e8 55%, #f3b6d1);
		display: grid;
		place-items: end center;
		padding-bottom: 8px;
	}
	.dc-thumb span {
		font-family: 'Zen Maru Gothic', sans-serif;
		font-weight: 900;
		color: #fffc;
		font-size: 15px;
		letter-spacing: 0.05em;
	}
	.dc-fields {
		margin: 10px 0 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 8px 12px;
	}
	.dc-fields dt {
		color: #f2f3f5;
		font-weight: 600;
		font-size: 13px;
	}
	.dc-fields dd {
		margin: 0;
		font-size: 13px;
	}
	.dc-footer {
		margin-top: 10px;
		font-size: 12px;
		color: #b5bac1;
	}
	.dc-select {
		margin-top: 8px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		background: #1e1f22;
		border: 1px solid #1e1f22;
		border-radius: 8px;
		padding: 9px 12px;
		font-size: 13.5px;
	}
	.dc-select svg {
		width: 18px;
		height: 18px;
		fill: none;
		stroke: #b5bac1;
		stroke-width: 2;
	}
	.dc-buttons {
		margin-top: 8px;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.dc-btn {
		background: #4e5058;
		color: #fff;
		font-size: 13.5px;
		font-weight: 500;
		padding: 6px 14px;
		border-radius: 8px;
	}
	.dc-btn.primary {
		background: #5865f2;
	}
	@media (max-width: 480px) {
		.dc-fields {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.dc-thumb {
			display: none;
		}
	}
</style>
