---
import AppLayout from '../layouts/AppLayout.astro';
import Petals from '../components/landing/Petals.astro';
import { buttonVariants } from '../components/ui/button';
import { Card } from '../components/ui/card';
import { cn } from '../lib/utils';

export const prerender = false;

if (Astro.locals.user) {
	return Astro.redirect('/dashboard/');
}

// Better Auth sends failed OAuth callbacks back here with `?error=<code>`.
const errorCode = Astro.url.searchParams.get('error');
const errorMessage = errorCode
	? errorCode === 'access_denied'
		? 'Discord login was cancelled. Try again whenever you are ready.'
		: 'Discord login did not finish. Try again.'
	: '';
---

<AppLayout title="Log in">
	<a class={buttonVariants({ variant: 'ghost', size: 'nav' })} href="/" slot="nav">← Back to Miru</a>

	<Card className="mx-auto grid max-w-[920px] animate-[rise_0.7s_cubic-bezier(0.2,0.7,0.2,1)_both] gap-0 overflow-hidden py-0 min-[761px]:grid-cols-2">
		<aside class="login-art" aria-hidden="true">
			<Petals />
			<div class="login-kanji">見る</div>
			<div class="login-art-copy">
				<p class="kicker">Miru dashboard</p>
				<p class="login-art-line">Your lists, alerts and server feed, all in one cosy place.</p>
			</div>
		</aside>

		<section class="login-panel">
			<img class="login-mark" src="/android-chrome-192x192.png" alt="" width="56" height="56" />
			<h1>Welcome back</h1>
			<p class="login-sub">Log in with the Discord account you use Miru with.</p>

			<button
			class={cn(
				buttonVariants(),
				'btn-discord w-full max-w-[320px] gap-2.5 border-0 leading-[normal] bg-[#5865f2] text-white [--edge:#3c45c5] [--glow:0_10px_24px_-8px_rgb(88_101_242/0.6)] disabled:opacity-85',
			)}
			type="button"
			id="discord-login"
		>
				<svg class="discord-logo" viewBox="0 0 24 24" aria-hidden="true">
					<path
						d="M20.32 4.37A19.8 19.8 0 0 0 15.43 2.85a13.9 13.9 0 0 0-.63 1.29 18.4 18.4 0 0 0-5.6 0 13 13 0 0 0-.63-1.29 19.7 19.7 0 0 0-4.9 1.52C.59 9.04-.25 13.6.17 18.09a19.9 19.9 0 0 0 6 3.03c.49-.66.92-1.36 1.29-2.1a12.9 12.9 0 0 1-2.03-.97c.17-.13.34-.26.5-.39a14.2 14.2 0 0 0 12.14 0l.5.39c-.65.38-1.33.71-2.04.98.37.73.8 1.43 1.29 2.09a19.8 19.8 0 0 0 6.01-3.03c.5-5.2-.84-9.72-3.51-13.72ZM8.02 15.33c-1.18 0-2.16-1.08-2.16-2.42 0-1.33.95-2.42 2.16-2.42 1.21 0 2.18 1.1 2.16 2.42 0 1.34-.96 2.42-2.16 2.42Zm7.97 0c-1.19 0-2.16-1.08-2.16-2.42 0-1.33.95-2.42 2.16-2.42 1.21 0 2.18 1.1 2.16 2.42 0 1.34-.95 2.42-2.16 2.42Z"
					></path>
				</svg>
				<span class="btn-label">Continue with Discord</span>
				<span class="spinner" aria-hidden="true"></span>
			</button>

			<p class="app-error" id="login-error" role="alert">{errorMessage}</p>

			<ul class="login-facts">
				<li>Miru sees your Discord name, avatar and email.</li>
				<li>It can't read your messages or act as you.</li>
			</ul>

			<p class="login-fine">
				New to Miru? <a href="/docs/getting-started/">Read the guide</a> · <a href="/docs/privacy/">Privacy</a>
			</p>
		</section>
	</Card>
</AppLayout>

<style>
	.login-art {
		position: relative;
		overflow: hidden;
		min-height: 480px;
		display: flex;
		align-items: flex-end;
		padding: 36px;
		background:
			radial-gradient(70% 60% at 80% 15%, color-mix(in srgb, var(--pink-soft) 85%, transparent), transparent 70%),
			radial-gradient(60% 50% at 10% 95%, color-mix(in srgb, var(--lav) 35%, transparent), transparent 70%),
			linear-gradient(160deg, var(--bg-alt), var(--pink-wash));
		border-right: 1px solid var(--line);
	}
	.login-kanji {
		position: absolute;
		top: 24px;
		left: 28px;
		font-family: var(--display);
		font-weight: 900;
		font-size: 150px;
		line-height: 1;
		writing-mode: vertical-rl;
		color: var(--pink);
		opacity: 0.16;
		user-select: none;
	}
	.login-art-copy {
		position: relative;
		z-index: 1;
	}
	.login-art-copy .kicker {
		margin-bottom: 8px;
	}
	.login-art-line {
		margin: 0;
		max-width: 300px;
		font-family: var(--display);
		font-weight: 700;
		font-size: 24px;
		line-height: 1.3;
		color: var(--ink);
	}

	.login-panel {
		padding: 56px 48px 40px;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}
	.login-mark {
		margin-bottom: 18px;
	}
	.login-panel h1 {
		font-family: var(--display);
		font-weight: 900;
		font-size: 2rem;
		margin: 0 0 8px;
	}
	.login-sub {
		color: var(--ink-soft);
		margin: 0 0 28px;
		max-width: 300px;
	}

	.discord-logo {
		width: 22px;
		height: 22px;
		fill: currentColor;
	}
	.spinner {
		display: none;
		width: 18px;
		height: 18px;
		border: 2.5px solid rgb(255 255 255 / 0.35);
		border-top-color: #fff;
		border-radius: 50%;
		animation: spin 0.7s linear infinite;
	}
	.btn-discord[aria-busy='true'] .spinner {
		display: block;
	}
	.btn-discord[aria-busy='true'] .discord-logo {
		display: none;
	}
	@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}

	.app-error {
		margin: 14px 0 0;
		max-width: 320px;
		font-weight: 600;
	}
	.app-error:empty {
		min-height: 0;
		margin: 0;
	}

	.login-facts {
		list-style: none;
		margin: 28px 0 0;
		padding: 16px 20px;
		width: 100%;
		max-width: 320px;
		text-align: left;
		font-size: 14px;
		color: var(--ink-soft);
		background: var(--bg);
		border: 1px dashed var(--line);
		border-radius: 16px;
	}
	.login-facts li {
		position: relative;
		padding-left: 22px;
	}
	.login-facts li + li {
		margin-top: 6px;
	}
	.login-facts li::before {
		content: '✿';
		position: absolute;
		left: 0;
		color: var(--pink);
	}

	.login-fine {
		margin: auto 0 0;
		padding-top: 28px;
		font-size: 14px;
		color: var(--muted);
	}
	.login-fine a {
		color: var(--pink-deep);
		font-weight: 600;
	}

	@media (max-width: 760px) {
		.login-art {
			min-height: 0;
			padding: 28px;
			border-right: 0;
			border-bottom: 1px solid var(--line);
		}
		.login-kanji {
			top: auto;
			bottom: -10px;
			left: auto;
			right: 12px;
			font-size: 96px;
			writing-mode: horizontal-tb;
		}
		.login-art-line {
			font-size: 20px;
		}
		.login-panel {
			padding: 40px 24px 32px;
		}
	}
</style>

<script>
	import { authClient } from '../lib/auth-client';

	const button = document.querySelector<HTMLButtonElement>('#discord-login')!;
	const label = button.querySelector<HTMLSpanElement>('.btn-label')!;
	const error = document.querySelector<HTMLParagraphElement>('#login-error')!;

	function reset(message: string) {
		error.textContent = message;
		button.disabled = false;
		button.removeAttribute('aria-busy');
		label.textContent = 'Continue with Discord';
	}

	button.addEventListener('click', async () => {
		button.disabled = true;
		button.setAttribute('aria-busy', 'true');
		label.textContent = 'Opening Discord…';
		error.textContent = '';
		try {
			// On success the client navigates to Discord, so only failures return here.
			const result = await authClient.signIn.social({
				provider: 'discord',
				callbackURL: '/dashboard/',
				errorCallbackURL: '/login/',
			});
			if (result.error) {
				reset(result.error.message || "Couldn't start Discord login. Try again in a moment.");
			}
		} catch {
			reset("Couldn't reach Miru. Check your connection and try again.");
		}
	});

	// Coming back via the browser's back button restores the busy state from cache.
	window.addEventListener('pageshow', (event) => {
		if (event.persisted) reset('');
	});
</script>
